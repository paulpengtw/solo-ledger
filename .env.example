# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.
#
# .env is used for LOCAL tooling and deploy automation only — it is NOT
# how the deployed app receives configuration.  Runtime variables for the
# Cloudflare Pages project are set on the project itself (see below).


# ── Cloudflare Pages runtime variables ────────────────────────────────────────
#
# These four are set on the Pages project itself (dashboard or wrangler) and
# are listed here for reference and for local `wrangler pages dev`.

# The deployed Apps Script web app /exec URL.
# Does not exist until the Apps Script web app is deployed.
EXPENSE_API_URL=

# Shared signing secret.  Must be byte-identical to the Apps Script Script
# Property of the same name, or every request fails signature verification.
EXPENSE_API_SECRET=

# Cloudflare Access team domain (e.g. yourteam.cloudflareaccess.com).
CF_ACCESS_TEAM_DOMAIN=

# AUD tag of the Cloudflare Access application, produced when the Access
# application is created.
CF_ACCESS_AUD=


# ── Cloudflare deploy credentials (optional, for automated deploys) ───────────

# Custom scoped API token — NOT the Global API Key.
# Minimum scopes: Account > Cloudflare Pages > Edit, and
#   Account > Access: Apps and Policies > Edit,
#   Account > Account Analytics > Read  (required by scripts/cf-consumption-report.mjs),
#   scoped to a single account, with an expiry.
# Add Zone > DNS > Edit and Zone > Zone > Read ONLY if using a custom domain.
CLOUDFLARE_API_TOKEN=

CLOUDFLARE_ACCOUNT_ID=


# ── Apps Script Script Properties — NOT set here ──────────────────────────────
#
# These are set in the Apps Script editor under
#   Project Settings › Script Properties
# and are listed here only so the full configuration surface is visible in
# one place.
#
#   EXPENSE_API_SECRET        (required) — must match the Pages env var above
#   LEDGER_SPREADSHEET_ID     (required) — the Google Spreadsheet ID that
#                               serves as the sole datastore
#   LEDGER_BACKUP_FOLDER_ID   (optional) — Google Drive folder ID for weekly
#                               backups. If left unset, the first backup run
#                               creates a folder named "Solo Ledger backups"
#                               and writes its ID back into this property
#                               automatically; set it only if you want backups
#                               in a specific existing folder.
